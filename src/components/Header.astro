---
const nav = [
  { href: '#about',      label: 'About'      },
  { href: '#experience', label: 'Experience' },
  { href: '#skills',     label: 'Skills'     },
  { href: '#personal',   label: 'Personal'   },
  { href: '#contact',    label: 'Contact'    },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur border-b border-slate-100">
  <div class="max-w-4xl mx-auto px-6 h-14 flex items-center justify-between">
    <a
      href="#about"
      class="font-semibold text-slate-900 hover:text-indigo-600 transition-colors text-sm whitespace-nowrap"
    >
      Pete C<span
        id="name-reveal"
        class="inline-block overflow-hidden whitespace-nowrap"
        style="width:0;vertical-align:text-bottom"
      >hitvicheankul</span>
    </a>
    <nav>
      <ul class="flex items-center gap-1">
        {nav.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="px-3 py-1.5 text-sm text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 rounded-md transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const el = document.getElementById('name-reveal') as HTMLElement;

  let naturalWidth = 0;

  function measure() {
    el.style.width = 'auto';
    naturalWidth = el.offsetWidth;
    // Immediately restore to scroll-driven width so there's no flash
    apply();
  }

  function progress(): number {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    return max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
  }

  function apply() {
    el.style.width = `${progress() * naturalWidth}px`;
  }

  // Measure on first paint (width:auto gives us the natural text width)
  measure();

  window.addEventListener('scroll', apply, { passive: true });

  // Re-measure if the viewport resizes (font-size may change at breakpoints)
  window.addEventListener('resize', measure, { passive: true });
</script>
