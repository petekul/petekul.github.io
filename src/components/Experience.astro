---
interface Role {
  company:  string;
  role:     string;
  period:   string;
  bullets:  string[];
}

const roles: Role[] = [
  {
    company: "Sportradar",
    role:    "Group Product Manager",
    period:  "Mar 2025 – Present",
    bullets: [
      "Lead and mentor a team of 6 Product Managers across sports content and fan engagement products, defining outcome-driven roadmaps for soccer, tennis and basketball within the ~€55m odds portfolio.",
      "Drove +24% YoY growth in monthly active users by launching AI-powered personalised betting experiences and long-tail sports product lines.",
      "Increased adoption of AI-personalisation features by 32% within 3 months through cross-functional go-to-market alignment across Engineering, Data, Design, Commercial, Marketing, Legal, and Support.",
      "Delivered +45% YoY revenue growth across two product lines by doubling subscriptions and optimising margins through deeper player data modelling.",
      "Defined and executed 1–3 year product strategies across multiple product lines, translating vision into quarterly OKRs and measurable outcomes.",
    ],
  },
  {
    company: "Sportradar",
    role:    "Senior Product Manager",
    period:  "Mar 2023 – Mar 2025",
    bullets: [
      "Managed 2 direct reports while mentoring PMs across the wider product organisation.",
      "Led two product development teams to build AI-powered personalisation and recommendation features, driving +41% growth in product subscriptions within 12 months.",
      "Built and scaled a 0→1 greenfield product and team — a core platform capability processing 9M transactions a day, driving €3.2M additional monthly revenue.",
    ],
  },
  {
    company: "Amobee",
    role:    "Product Manager",
    period:  "May 2022 – Mar 2023",
    bullets: [
      "Product owner of a machine-learning fan-engagement product, using stochastic mathematical models and deep data insights to double active users within 9 months.",
    ],
  },
  {
    company: "Amobee",
    role:    "Associate Product Manager",
    period:  "May 2021 – May 2022",
    bullets: [
      "Led implementation of creative management tooling within ITV's PlanetV addressable TV advertising platform, focusing on product specification and feature delivery.",
    ],
  },
  {
    company: "Worldpay",
    role:    "Full-stack Developer",
    period:  "Oct 2016 – Apr 2021",
    bullets: [
      "Began as a front-end engineer (Angular, React) on high-volume payment products processing billions of payments daily, then up-skilled across AWS to become a full-stack engineer specialising in Java and TypeScript.",
    ],
  },
];

const education = {
  institution: "Queen Mary, University of London",
  degree:      "BSc Computer Science with Industrial Experience",
  result:      "First Class with Honours",
};
---

<section id="experience" class="py-24">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-2">Experience</h2>
    <p class="text-mid mb-12">Where I've worked and what I've built.</p>

    <div class="relative">
      <div class="absolute left-0 top-2 bottom-2 w-px bg-teal/30 ml-1.5 hidden md:block" aria-hidden="true"></div>

      <div class="space-y-10">
        {roles.map((job) => (
          <div class="md:pl-10 relative">
            <div class="hidden md:block absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand ring-4 ring-[#FAF7F2]" aria-hidden="true"></div>
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-3">
              <div>
                <h3 class="text-lg font-semibold text-surface">{job.role}</h3>
                <p class="text-brand font-medium">{job.company}</p>
              </div>
              <p class="text-sm text-mid sm:text-right shrink-0">{job.period}</p>
            </div>
            <ul class="space-y-2">
              {job.bullets.map((bullet) => (
                <li class="text-mid text-sm pl-4 relative before:content-['—'] before:absolute before:left-0 before:text-teal">
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mt-20">
      <h2 class="text-3xl font-bold text-surface mb-2">Education</h2>
      <div class="mt-8 md:pl-10 relative">
        <div class="hidden md:block absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand ring-4 ring-[#FAF7F2]" aria-hidden="true"></div>
        <h3 class="text-lg font-semibold text-surface">{education.degree}</h3>
        <p class="text-brand font-medium">{education.institution}</p>
        <p class="text-sm text-mid mt-1">{education.result}</p>
      </div>
    </div>
  </div>
</section>
