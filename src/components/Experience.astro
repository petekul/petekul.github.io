---
interface Role {
  company:  string;
  role:     string;
  period:   string;
  bullets:  string[];
}

const roles: Role[] = [
  {
    company: "Sportradar",
    role:    "Group Product Manager",
    period:  "Mar 2025 - Present",
    bullets: [
      "Scaled and developed a team of 6 Product Managers across core sports content, establishing product operating models that introduced structured planning cycles, OKR frameworks and cross-functional alignment.",
      "Owned strategy and roadmap for a €55M business-critical odds platform — translating a 3-year vision into quarterly OKRs and delivering platform modernisation that enabled 7x faster time-to-market.",
      "Shipped AI-personalised betting experiences that grew bets placed by 22% within the first year, contributing to sustained revenue growth of +45% YoY.",
      "Drove 2x subscription growth and improved margins by ~8p.p through enhanced player data insights and deepened behavioural modelling.",
      "Accelerated adoption of personalisation experiences by 32% within 3 months through refined go-to-market execution and alignment across Engineering, Data, Design, Commercial, Marketing, Legal, and Support.",
    ],
  },
  {
    company: "Sportradar",
    role:    "Senior Product Manager",
    period:  "Mar 2023 - Mar 2025",
    bullets: [
      "Managed and mentored a team of 2 PMs, improving product execution through structured coaching and raising overall delivery consistency across fan engagement initiatives.",
      "Led two product teams to ship AI-powered personalisation and recommendation features, driving +41% growth in product subscriptions within 12 months.",
      "Built a 0-to-1 platform capability from scratch — assembling the team, shaping the product strategy, and launching a product that now processes 9M transactions daily, generating €3.2M in incremental monthly revenue.",
    ],
  },
  {
    company: "Sportradar",
    role:    "Product Manager",
    period:  "May 2022 - Mar 2023",
    bullets: [
      "Built and scaled a machine learning fan-engagement product, leveraging predictive models and behavioural insights to 2x active users within 9 months.",
    ],
  },
  {
    company: "Amobee",
    role:    "Associate Product Manager",
    period:  "May 2021 - May 2022",
    bullets: [
      "Led the creative management tooling initiative within ITV's Planet V advertising platform, focusing on content upload, configuration and campaign delivery which has now launched over 41,000+ campaigns.",
    ],
  },
  {
    company: "Worldpay",
    role:    "Full-stack Developer",
    period:  "Oct 2016 - Apr 2021",
    bullets: [
      "Built and launched global eCommerce checkout capabilities, enabling merchants to accept secure and compliant online payments across multiple markets.",
      "Engineered several high-volume payment products which processed 1B+ payments daily.",
      "Developed strong expertise in Java, Typescript and React."
    ],
  },
  {
    company: "Kurtosys Systems",
    role:    "Junior Product Engineer",
    period:  "Aug 2014 - Aug 2015",
    bullets: [
      "Part of a global engineering team working on the automation and generation of Fund Factsheets for investment management and PE firms.",
      "Utilised C#, JavaScript, .NET Framework to fix bugs and develop enhancements in an agile environment.",
    ],
  },
];

const education = {
  institution: "Queen Mary, University of London",
  degree:      "BSc Computer Science with Industrial Experience",
  result:      "First Class with Honours",
  award:       "Honourable Mention: Outstanding Computer Science Project 2016",
};
---

<section id="experience" class="py-24">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-2">Experience</h2>
    <p class="text-mid mb-12">Where I've worked and what I've built.</p>

    <div class="relative">
      <div class="absolute left-0 top-2 bottom-2 w-px bg-teal/30 ml-1.5 hidden md:block" aria-hidden="true"></div>

      <div class="space-y-10">
        {roles.map((job) => (
          <div class="md:pl-10 relative">
            <div class="hidden md:block absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand ring-4 ring-[#FAF7F2]" aria-hidden="true"></div>
            <div class="mb-3">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                <h3 class="text-lg font-semibold text-surface">{job.role}</h3>
                <p class="text-sm text-mid shrink-0">{job.period}</p>
              </div>
              <p class="text-brand font-medium">{job.company}</p>
            </div>
            <ul class="space-y-2">
              {job.bullets.map((bullet) => (
                <li class="text-mid text-sm pl-4 relative before:content-['—'] before:absolute before:left-0 before:text-teal">
                  {bullet}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="mt-20">
      <h2 class="text-3xl font-bold text-surface mb-2">Education</h2>
      <div class="mt-8 md:pl-10 relative">
        <div class="hidden md:block absolute left-0 top-1.5 w-3 h-3 rounded-full bg-brand ring-4 ring-[#FAF7F2]" aria-hidden="true"></div>
        <h3 class="text-lg font-semibold text-surface">{education.degree}</h3>
        <p class="text-brand font-medium">{education.institution}</p>
        <p class="text-sm text-mid mt-1">{education.result}</p>
        <p class="text-sm text-mid mt-0.5">{education.award}</p>
      </div>
    </div>
  </div>
</section>
