---
// ← Replace with your actual skills
const skillGroups = [
  {
    category: "Languages",
    skills: ["Python", "TypeScript", "JavaScript", "SQL"],
  },
  {
    category: "Frameworks & Libraries",
    skills: ["React", "Node.js", "FastAPI", "Next.js"],
  },
  {
    category: "Tools & Platforms",
    skills: ["Git", "Docker", "AWS", "PostgreSQL"],
  },
  {
    category: "Other",
    skills: ["REST APIs", "CI/CD", "Agile", "System Design"],
  },
];
---

<section id="skills" class="py-24 bg-slate-50">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-slate-900 mb-2">Skills</h2>
    <p class="text-slate-500 mb-12">Technologies and tools I work with.</p>

    <div class="grid sm:grid-cols-2 gap-10">
      {skillGroups.map(({ category, skills }) => (
        <div>
          <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">
            {category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-sm rounded-full font-medium hover:border-indigo-300 hover:text-indigo-700 transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
