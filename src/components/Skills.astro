---
const languages = [
  { flag: "🇬🇧", label: "English", tooltip: "Native tongue"  },
  { flag: "🇹🇭", label: "Thai",    tooltip: "Mother tongue"  },
];

const interests = [
  { emoji: "🧗", label: "Climbing",     tooltip: "Budding v3–v5 climber"                  },
  { emoji: "🏂", label: "Snowboarding", tooltip: "Did my first black run this year!"       },
  { emoji: "🤿", label: "Scuba Diving", tooltip: "SSI Advanced open water diver certified" },
  { emoji: "🎲", label: "Board Games",  tooltip: "Strategy enthusiast"                     },
  { emoji: "✈️", label: "Travel",       tooltip: "🇬🇧 🇺🇸 🇲🇽 🇫🇷 🇪🇸 🇵🇹 🇳🇱 🇩🇪 🇦🇹 🇨🇭 🇮🇹 🇭🇷 🇭🇺 🇸🇮 🇬🇷 🇧🇬 🇵🇱 🇩🇰 🇸🇪 🇹🇷 🇲🇦 🇨🇳 🇹🇭 🇰🇷 🇯🇵 🇮🇩 🇻🇳 🇸🇬 🇲🇾" },
  { emoji: "🎸", label: "Guitar",       tooltip: "Wannabe acoustic jammer"                 },
];

const skillGroups = [
  {
    category: "Product & Strategy",
    skills: ["Product Strategy", "OKRs & Roadmapping", "0→1 Product Development", "Go-to-Market", "Stakeholder Management", "P&L Ownership", "Pricing & Monetisation", "Product Analytics", "Experimentation & A/B Testing", "API Product Management"],
  },
  {
    category: "Leadership",
    skills: ["Team Leadership", "Cross-functional Alignment", "Mentoring & Coaching", "Multi-squad Management", "Hiring & Team Building", "Executive Stakeholder Communication"],
  },
  {
    category: "Data & AI",
    skills: ["Predictive Modelling", "AI Personalisation", "Behavioural Analytics", "Data-driven Prioritisation", "Machine Learning Applications"],
  },
  {
    category: "Technical",
    skills: ["TypeScript", "JavaScript", "Java", "React", "AWS", "Python", "SQL", "HTML/CSS", "Data Modelling", "Agile / Scrum"],
  },
  {
    category: "Domains",
    skills: ["Sports Data", "FinTech", "AdTech", "Payments", "Behavioural Data & Personalisation", "Subscription Products", "B2B2C Platforms"],
  },
];
---

<section id="skills" class="py-24 bg-bg-alt">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-12">Skills</h2>

    <div class="grid sm:grid-cols-2 gap-10">
      {skillGroups.map(({ category, skills }) => (
        <div>
          <h3 class="text-xs font-semibold text-mid uppercase tracking-widest mb-3">
            {category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skills.map((skill) => (
              <span class="px-3 py-1.5 bg-bg border border-teal/30 text-surface text-sm rounded-full font-medium hover:border-brand hover:text-brand-accessible transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
      <div>
        <h3 class="text-xs font-semibold text-mid uppercase tracking-widest mb-3">Languages</h3>
        <div class="flex flex-wrap gap-2">
          {languages.map(({ flag, label, tooltip }) => (
            <span tabindex="0" class="interest-tag relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-bg border border-teal/30 text-surface text-sm font-medium hover:border-brand hover:text-brand-accessible transition-colors cursor-default">
              <span>{flag}</span>
              {label}
              <span class="interest-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2.5 py-1.5 rounded-lg bg-surface text-white text-xs pointer-events-none opacity-0 transition-opacity duration-150 z-10 w-max max-w-[14rem] text-center leading-relaxed">
                {tooltip}
                <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-surface"></span>
              </span>
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-14">
      <p class="text-xs font-semibold text-mid uppercase tracking-widest mb-3">Outside of work</p>
      <div class="flex flex-wrap gap-2">
        {interests.map(({ emoji, label, tooltip }) => (
          <span tabindex="0" class="interest-tag relative inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-bg border border-teal/30 text-surface text-sm font-medium hover:border-brand hover:text-brand-accessible transition-colors cursor-default">
            <span>{emoji}</span>
            {label}
            <span class="interest-tooltip absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2.5 py-1.5 rounded-lg bg-surface text-white text-xs pointer-events-none opacity-0 transition-opacity duration-150 z-10 w-max max-w-[14rem] text-center leading-relaxed">
              {tooltip}
              <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-surface"></span>
            </span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .interest-tag:hover .interest-tooltip,
  .interest-tag:focus-within .interest-tooltip {
    opacity: 1;
  }
</style>
