---
interface Project {
  name:        string;
  company:     string;
  metric:      string;
  metricLabel: string;
  description: string;
  tags:        string[];
}

const projects: Project[] = [
  {
    name:        "AI-Personalised Bet Builders",
    company:     "Sportradar",
    metric:      "+41%",
    metricLabel: "product subscriptions in 1 year",
    description: "Built and scaled AI-personalised betting experiences (such as personalised pre-built combinations), increasing bets placed by 22% within the first year of launch and delivering sustained revenue growth of +45% YoY.",
    tags:        ["AI Personalisation", "Product Discovery", "Product Launch", "B2B2C", "Quants"],
  },
  {
    name:        "Odds Data Platform",
    company:     "Sportradar",
    metric:      "€55m",
    metricLabel: "under strategic ownership",
    description: "Defined and executed a 2-3 year product strategy across the core odds portfolio, translating vision into quarterly OKRs and leading the migration of a €55M business-critical platform, enabling 7x faster feature delivery.",
    tags:        ["Product Strategy", "Leadership", "B2B", "Scaling"],
  },
  {
    name:        "Planet V: Creative Management",
    company:     "Amobee",
    metric:      "41,000+",
    metricLabel: "video advertising campaigns launched",
    description: "Led the implementation of creative management tooling within ITV's Planet V addressable TV advertising platform, focusing on content upload, configuration and campaign delivery.",
    tags:        ["Product Development", "AdTech", "SSP", "B2B"],
  },
  {
    name:        "Checkout",
    company:     "Worldpay",
    metric:      "1B+",
    metricLabel: "payments processed through checkout",
    description: "Built and launched global eCommerce checkout capabilities, enabling merchants to accept secure and compliant online payments across multiple markets.",
    tags:        ["Payments", "Fan Engagement", "B2B2C", "Software Development"],
  },
];
---

<section id="projects" class="py-24 bg-bg-alt">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-12">What I've Shipped</h2>

    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map(({ name, company, metric, metricLabel, description, tags }) => (
        <div class="group p-6 rounded-xl bg-white border border-teal/20 hover:border-brand hover:shadow-[0_4px_16px_rgba(184,92,56,0.12)] transition-all flex flex-col">
          <p class="text-xs font-semibold text-brand-accessible uppercase tracking-widest mb-3">{company}</p>
          <h3 class="text-base font-bold text-surface mb-4 leading-snug">{name}</h3>

          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-3xl font-bold text-brand">{metric}</span>
            <span class="text-xs text-mid">{metricLabel}</span>
          </div>

          <p class="text-sm text-mid leading-relaxed mb-5 flex-1">{description}</p>

          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-bg text-mid font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
