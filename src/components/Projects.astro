---
interface Project {
  name:        string;
  company:     string;
  metric:      string;
  metricLabel: string;
  description: string;
  tags:        string[];
}

const projects: Project[] = [
  {
    name:        "Bet Builder & AI Personalisation",
    company:     "Sportradar",
    metric:      "+24%",
    metricLabel: "monthly active users YoY",
    description: "Led the launch of AI-powered personalised betting experiences and long-tail sports product lines, driving sustained growth in engagement across soccer, tennis, and basketball.",
    tags:        ["AI/ML", "Personalisation", "Sports Betting", "B2B SaaS"],
  },
  {
    name:        "Odds Platform",
    company:     "Sportradar",
    metric:      "€55m",
    metricLabel: "portfolio under strategy",
    description: "Defined and executed 1–3 year product strategy across the core odds portfolio, translating vision into quarterly OKRs and delivering +45% YoY revenue growth across two product lines.",
    tags:        ["Product Strategy", "OKRs", "Sports Data", "Revenue Growth"],
  },
  {
    name:        "Core Data Platform",
    company:     "Sportradar",
    metric:      "9M",
    metricLabel: "transactions processed daily",
    description: "Built and scaled a 0→1 greenfield platform from the ground up — a core infrastructure capability that now drives €3.2M in additional monthly revenue.",
    tags:        ["0→1 Product", "Platform", "FinTech", "Engineering"],
  },
  {
    name:        "Fan Engagement Product",
    company:     "Amobee",
    metric:      "2×",
    metricLabel: "active users in 9 months",
    description: "Product owner of an ML-powered fan engagement product, applying stochastic mathematical models and deep data insights to double the active user base within 9 months.",
    tags:        ["Machine Learning", "Fan Engagement", "AdTech", "Growth"],
  },
];
---

<section id="projects" class="py-24 bg-[#F0EAE0]">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-2">What I've Shipped</h2>
    <p class="text-mid mb-12">Products I've taken from idea to impact.</p>

    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map(({ name, company, metric, metricLabel, description, tags }) => (
        <div class="group p-6 rounded-xl bg-white border border-teal/20 hover:border-brand hover:shadow-md transition-all flex flex-col">
          <p class="text-xs font-semibold text-brand uppercase tracking-widest mb-3">{company}</p>
          <h3 class="text-base font-bold text-surface mb-4 leading-snug">{name}</h3>

          <div class="flex items-baseline gap-2 mb-4">
            <span class="text-3xl font-bold text-brand">{metric}</span>
            <span class="text-xs text-mid">{metricLabel}</span>
          </div>

          <p class="text-sm text-mid leading-relaxed mb-5 flex-1">{description}</p>

          <div class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <span class="px-2.5 py-1 text-xs rounded-full bg-[#FAF7F2] text-mid font-medium">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
