---
const name = "Pete Chitvicheankul";
const role = "Group Product Manager";
const bio  = "10+ years across product and engineering, building and scaling data-driven consumer products. Led multi-squad teams to deliver sustained double-digit growth in engagement and revenue across platforms handling millions of transactions daily. Experience spans FinTech, AdTech, Payments, and Sports Data.";

const metrics = [
  { value: "10+",  label: "Years in product\n& engineering"      },
  { value: "6",    label: "PMs led\n& mentored"                  },
  { value: "+24%", label: "Monthly active\nusers YoY"            },
  { value: "€55m", label: "Portfolio\nunder strategy"            },
];
---

<section id="about" class="min-h-screen flex flex-col justify-center bg-surface text-white pt-14">
  <div class="max-w-4xl mx-auto px-6 py-24 w-full">
    <p class="text-white/60 font-mono text-sm mb-4">Hi, I'm</p>
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4">
      {name}
    </h1>
    <h2 class="text-2xl md:text-3xl text-white/80 font-light mb-8">
      {role}
    </h2>
    <p class="text-white/70 text-lg max-w-xl leading-relaxed mb-10">
      {bio}
    </p>
    <div class="flex flex-wrap gap-4 mb-16">
      <a href="#contact" class="px-6 py-3 bg-brand hover:bg-brand/85 text-white rounded-lg font-medium transition-colors">
        Get in touch
      </a>
      <a href="/pete-chitvicheankul-cv.pdf" rel="noopener noreferrer" class="px-6 py-3 border border-white/40 hover:border-white text-white/80 hover:text-white rounded-lg font-medium transition-colors">
        Download CV
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-white/10 rounded-xl overflow-hidden">
      {metrics.map(({ value, label }) => (
        <div class="bg-white/5 px-6 py-5">
          <p class="text-3xl font-bold text-white mb-1">{value}</p>
          <p class="text-xs text-white/60 leading-snug whitespace-pre-line">{label}</p>
        </div>
      ))}
    </div>
  </div>
  <div class="flex justify-center pb-12">
    <a href="#experience" class="text-white/40 hover:text-white/70 transition-colors animate-bounce" aria-label="Scroll down">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </a>
  </div>
</section>
