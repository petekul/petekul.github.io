---
import emailSvg    from '../assets/envelope-fill.svg?raw';
import linkedinSvg from '../assets/linkedin.svg?raw';
import githubSvg   from '../assets/github.svg?raw';

const links = [
  {
    label:   "Email",
    href:    "mailto:pete.chitvicheankul@gmail.com",
    svg:     emailSvg,
    display: "pete.chitvicheankul@gmail.com",
  },
  {
    label:   "LinkedIn",
    href:    "https://linkedin.com/in/petekul",
    svg:     linkedinSvg,
    display: "linkedin.com/in/petekul",
  },
  {
    label:   "GitHub",
    href:    "https://github.com/petekul",
    svg:     githubSvg,
    display: "github.com/petekul",
  },
];
---

<section id="contact" class="py-24 bg-bg-alt">
  <div class="px-8 lg:px-14">
    <h2 class="text-3xl font-bold text-surface mb-2">Get in touch</h2>
    <p class="text-mid mb-10 max-w-sm">
      Open to Group PM and Director-level opportunities. Always happy to talk product strategy, data, or anything interesting.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 mb-16">
      {links.map(({ label, href, svg, display }) => (
        <a
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="flex items-center gap-3 px-5 py-4 bg-white border border-teal/20 hover:border-brand hover:shadow-[0_4px_16px_rgba(184,92,56,0.12)] rounded-xl transition-all text-left"
        >
          <span class="text-brand shrink-0" aria-hidden="true" set:html={svg} />
          <div>
            <p class="text-xs text-mid mb-0.5">{label}</p>
            <p class="text-sm font-medium text-surface">{display}</p>
          </div>
        </a>
      ))}
    </div>

    <p class="text-mid/60 text-sm">
      Built with <a href="https://astro.build" class="hover:text-mid transition-colors" target="_blank" rel="noopener noreferrer">Astro</a> & Tailwind CSS · Hosted on GitHub Pages
    </p>
  </div>
</section>
