---
const bio = [
  "I am a Group Product Manager with 10+ years across product and engineering, building and scaling data-driven consumer platforms across SportsTech, FinTech, AdTech, and Payments.",
  "I've led AI-powered personalisation initiatives, 0→1 product launches, and platforms processing millions of transactions daily — driving measurable growth across engagement and revenue.",
  "I thrive in ambiguity and fast-moving environments, quickly turning complex problems into clear execution plans and measurable outcomes. My engineering background helps me bridge technical depth with commercial strategy, aligning teams and stakeholders from implementation details through to executive decision-making.",
  "I'm passionate about simplifying complexity through data, experimentation, and customer-focused product thinking.",
];

const metrics = [
  { value: "10+",  label: "Years across product\n& engineering" },
  { value: "€55m", label: "Odds Portfolio\nunder strategy ownership" },
  { value: "12+", label: "Products shipped" },
];

---

<section id="about" class="py-20 px-8 lg:px-14">
  <h2 class="text-3xl font-bold text-surface mb-2">Get to know Pete</h2>

  <div class="space-y-4 text-mid text-base leading-relaxed mb-12">
    {bio.map(p => <p>{p}</p>)}
  </div>

  <div class="flex mb-12">
    {metrics.map(({ value, label }, i) => (
      <div class={`flex-1 ${i > 0 ? 'border-l border-surface/15 pl-8' : ''}`}>
        <p class="text-3xl font-bold text-brand">{value}</p>
        <p class="text-xs text-mid leading-snug whitespace-pre-line mt-1">{label}</p>
      </div>
    ))}
  </div>
</section>
