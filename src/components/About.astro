---
const bio = [
  "I'm a Group Product Manager with 10+ years' experience across product and engineering in Payments, FinTech, Sports Data, and AdTech. I started as a full-stack engineer and grew into P&L ownership across high-volume, data-rich product environments.",
  "I operate at the intersection of user behaviour, data insight, and commercial outcomes, using data to inform prioritisation, shape product direction, and make executive-level decisions across growth and revenue opportunities in ambiguous environments.",
  "I've led AI-powered personalisation products, built 0-to-1 products, and scaled experiences used across millions of daily interactions, driving measurable growth in engagement, subscriptions, and revenue in fast-moving, competitive markets.",
  "At Sportradar, I currently lead a team of 6 Product Managers across core sports content, owning strategy and execution for a €55M business-critical product portfolio.",
];

const metrics = [
  { value: "10+",  label: "Years across product\n& engineering" },
  { value: "€55m", label: "Product Portfolio\nunder strategy ownership" },
  { value: "12+",  label: "Products shipped" },
];

---

<section id="about" class="py-24 px-8 lg:px-14">
  <h2 class="text-3xl font-bold text-surface mb-8">About</h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-8 mb-12">
    {metrics.map(({ value, label }) => (
      <div>
        <p class="text-3xl font-bold text-brand">{value}</p>
        <p class="text-xs text-mid leading-snug whitespace-pre-line mt-1">{label}</p>
      </div>
    ))}
  </div>

  <div class="space-y-4 text-mid text-base leading-relaxed">
    {bio.map(p => <p>{p}</p>)}
  </div>
</section>
