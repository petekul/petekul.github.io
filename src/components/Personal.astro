---
// ← Replace with your actual interests / hobbies
const interests = [
  {
    emoji: "🏔️",
    title: "Outdoors",
    description: "Love hiking and being in nature.",
  },
  {
    emoji: "📚",
    title: "Reading",
    description: "Currently reading [book title].",
  },
  {
    emoji: "🎵",
    title: "Music",
    description: "Into [genres / artists].",
  },
  {
    emoji: "✈️",
    title: "Travel",
    description: "Exploring new places whenever I can.",
  },
];
---

<section id="personal" class="py-24 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-3xl font-bold text-surface mb-2">Personal</h2>
    <p class="text-mid mb-12">A bit about who I am outside of work.</p>

    <div class="grid sm:grid-cols-2 gap-6">
      {interests.map(({ emoji, title, description }) => (
        <div class="p-6 rounded-xl border border-teal/20 hover:border-teal hover:shadow-sm transition-all">
          <div class="text-3xl mb-3">{emoji}</div>
          <h3 class="font-semibold text-surface mb-1">{title}</h3>
          <p class="text-mid text-sm">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
